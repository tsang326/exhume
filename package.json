{
  "name": "exhume",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "build:mcp": "vite build --config vite.mcp.config.ts",
    "typecheck": "tsc --noEmit && tsc -p src/core/tsconfig.json --noEmit && tsc -p src/web/logic/tsconfig.json --noEmit && tsc -p src/web/worker/tsconfig.json --noEmit && tsc -p src/mcp/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:dom": "vitest run --config vitest.dom.config.ts",
    "test:watch": "vitest",
    "test:fuzz": "FC_RUNS_MULTIPLIER=10 vitest run hostile"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "fast-check": "4.3.0",
    "happy-dom": "21.0.4",
    "typescript": "~5.9.3",
    "vite": "^7.1.7",
    "vitest": "3.2.4"
  },
  "license": "MIT"
}
